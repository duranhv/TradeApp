# ─── App ───────────────────────────────────────────────
APP_NAME=TradeApp
DEBUG=false
SECRET_KEY=your-secret-key-change-in-production

# ─── Database ──────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://tradeapp:password@localhost:5432/tradeapp

# ─── Redis ─────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ─── Brokers / Market Data ─────────────────────────────
# IOL (Invertir Online) - Requiere cuenta
IOL_USERNAME=
IOL_PASSWORD=

# MatbaRofex - Requiere cuenta
MATBA_USER=
MATBA_PASSWORD=

# ─── AI / NLP (opcional - para análisis fundamental) ───
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ─── Notificaciones ────────────────────────────────────
# Telegram Bot
TELEGRAM_BOT_TOKEN=

# Email (Gmail)
SMTP_USER=
SMTP_PASSWORD=

# ─── Frontend ──────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
